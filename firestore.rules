rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Game Room rules
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // Allow update if:
      // 1. User is one of the players already in the room
      // 2. Or user is joining a room that has < 2 players
      allow update: if request.auth != null && (
        resource.data.players.keys().hasAny([request.auth.uid]) ||
        resource.data.players.size() < 2
      );

      // Boards subcollection
      match /boards/{playerId} {
        // Only owner can create or update their board
        allow create, update: if request.auth != null && request.auth.uid == playerId;

        // ALLOW DELETION if:
        // 1. It is your own board
        // 2. OR the game is FINISHED (this allows any player to trigger the 'Play Again' reset)
        allow delete: if request.auth != null && (
          request.auth.uid == playerId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'FINISHED'
        );

        // Any player in the room can read any board (required for authoritative client-side logic)
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.players.keys().hasAny([request.auth.uid]);
      }
    }
  }
}
